#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPOSITORY_ROOT=$(dirname -- "$SCRIPT_DIR")

if [ -x "$REPOSITORY_ROOT/.venv/bin/python" ]; then
  PYTHON="$REPOSITORY_ROOT/.venv/bin/python"
else
  PYTHON=$(command -v python3)
fi

# App Walk has a bounded, read-only/ephemeral adapter. Other capabilities retain
# their existing parser, behavior and exit status without argument rewriting.
if [ "${2-}" = "app-walk" ]; then
  exec "$PYTHON" "$REPOSITORY_ROOT/godiesel_app_walk.py" "$@"
fi

exec "$PYTHON" "$REPOSITORY_ROOT/godiesel_control.py" "$@"
