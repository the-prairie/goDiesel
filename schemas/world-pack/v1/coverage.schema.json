{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godiesel.world/schemas/world-pack/v1/coverage.schema.json",
  "title": "World Pack quality-cell coverage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cellSizeM", "coordinateReference", "cells"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "cellSizeM": { "type": "integer", "minimum": 1 },
    "coordinateReference": { "const": "route-local-enu-v1" },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "eastingM",
          "northingM",
          "terrain",
          "visual",
          "structures",
          "collision",
          "acquisitionDate",
          "sourceDate",
          "transformationVersion",
          "accuracyM",
          "confidence",
          "visualQuality",
          "physicsQuality"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^-?[0-9]+:-?[0-9]+$" },
          "eastingM": { "type": "integer" },
          "northingM": { "type": "integer" },
          "terrain": { "$ref": "#/$defs/evidence" },
          "visual": { "$ref": "#/$defs/evidence" },
          "structures": { "$ref": "#/$defs/evidence" },
          "collision": { "$ref": "#/$defs/evidence" },
          "acquisitionDate": { "type": ["string", "null"] },
          "sourceDate": { "type": ["string", "null"] },
          "transformationVersion": { "type": "string", "minLength": 1 },
          "accuracyM": { "type": ["number", "null"], "minimum": 0 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "visualQuality": { "enum": ["unavailable", "core", "detailed", "archival"] },
          "physicsQuality": { "enum": ["unavailable", "core", "detailed"] }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "sourceSha256"],
      "properties": {
        "class": {
          "enum": ["recorded", "derived", "measured", "reconstructed", "procedural", "unavailable"]
        },
        "sourceSha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
