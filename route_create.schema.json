{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godiesel.local/schemas/route-create.schema.json",
  "title": "goDiesel route share intake",
  "$defs": {
    "curation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vibe": { "type": "string", "minLength": 1 },
        "ideal_use": { "type": "string", "minLength": 1 },
        "terrain": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "difficulty": { "type": "string", "minLength": 1 },
        "highlights": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "caveats": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "seasonality": { "type": "string", "minLength": 1 },
        "editorial_note": { "type": "string", "minLength": 1 },
        "review_status": { "enum": ["draft", "reviewed", "published"] }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "at_distance_m", "kind", "evidence", "body"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "at_distance_m": { "type": "number", "minimum": 0 },
        "kind": { "enum": ["note", "landmark", "warning", "image"] },
        "evidence": { "enum": ["recorded", "derived", "measured", "hypothesis"] },
        "body": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "thumb_url", "width", "height"],
          "properties": {
            "url": { "type": "string", "pattern": "^media/" },
            "thumb_url": { "type": "string", "pattern": "^media/" },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "association"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "association": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "route" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "annotation_id"],
              "properties": {
                "kind": { "const": "annotation" },
                "annotation_id": { "type": "string", "minLength": 1 }
              }
            }
          ]
        }
      }
    },
    "proposalMedia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "kind",
        "sha256",
        "staged_path",
        "association",
        "capture_metadata"
      ],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["image", "video"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "staged_path": { "type": "string", "pattern": "^\\.route-share/staging/" },
        "association": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "route" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "annotation_id"],
              "properties": {
                "kind": { "const": "annotation" },
                "annotation_id": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "capture_metadata": { "type": "object" }
      }
    },
    "routeSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity_id", "status"],
      "properties": {
        "activity_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "status": { "enum": ["approved", "pending", "rejected", "archived"] },
        "source_gpx": { "type": "string", "pattern": "^route_sources/" },
        "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "activity_name": { "type": "string" },
        "activity_type": { "enum": ["Run", "Ride"] },
        "date": { "type": "string" },
        "region": { "type": "string" },
        "title": { "type": "string" },
        "lifecycle": { "enum": ["completed", "discovered", "planned"] },
        "lifecycle_evidence": { "type": "object" },
        "description": { "type": "string" },
        "theme": { "type": "string" },
        "difficulty": { "type": "string" },
        "completion_rule": { "type": "string" },
        "blurb": { "type": "string" },
        "visibility": { "enum": ["public", "hidden"] },
        "curation": { "$ref": "#/$defs/curation" },
        "annotations": {
          "type": "array",
          "items": { "$ref": "#/$defs/annotation" }
        },
        "replay_mode": { "enum": ["atlas", "earth"] },
        "source_media": { "type": "array", "items": { "type": "object" } },
        "route_share_proposal_id": { "type": "string" },
        "route_share_contract_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "document_type",
        "proposal_id",
        "operation",
        "source",
        "route_spec",
        "observations",
        "media",
        "warnings",
        "blocking_errors"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "document_type": { "const": "route-share-proposal" },
        "proposal_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "operation": { "enum": ["create", "update"] },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "existing_slug"],
              "properties": {
                "mode": { "const": "existing-route" },
                "existing_slug": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "filename", "sha256", "staged_path", "durable_path"],
              "properties": {
                "mode": { "const": "gpx" },
                "filename": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "staged_path": { "type": "string", "pattern": "^\\.route-share/staging/" },
                "durable_path": { "type": "string", "pattern": "^route_sources/" }
              }
            }
          ]
        },
        "base_route_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "route_spec": { "$ref": "#/$defs/routeSpec" },
        "observations": { "type": "object" },
        "media": { "type": "array", "items": { "$ref": "#/$defs/proposalMedia" } },
        "proposed_share_name": { "type": ["string", "null"] },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        },
        "blocking_errors": { "type": "array" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version"],
      "properties": {
        "schema_version": { "const": 1 },
        "existing_slug": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "gpx_path": { "type": "string", "minLength": 1 },
        "activity_type": { "enum": ["Run", "Ride"] },
        "route_name": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "source_description": { "type": "string", "minLength": 1 },
        "activity_date": { "type": "string" },
        "desired_route_id": {
          "type": "string",
          "pattern": "^gpx-[a-z0-9][a-z0-9-]{2,59}[a-z0-9]$"
        },
        "lifecycle": { "enum": ["discovered", "completed"] },
        "completion_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "description"],
          "properties": {
            "kind": { "const": "owner_recorded" },
            "description": { "type": "string", "minLength": 1 }
          }
        },
        "curation": { "$ref": "#/$defs/curation" },
        "annotations": {
          "type": "array",
          "items": { "$ref": "#/$defs/annotation" }
        },
        "media": {
          "type": "array",
          "items": { "$ref": "#/$defs/media" }
        },
        "replay_mode": { "enum": ["atlas", "earth"] },
        "proposed_share_name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[a-z0-9-]*[a-z0-9])?$",
          "maxLength": 57
        }
      },
      "oneOf": [
        {
          "required": ["existing_slug"],
          "not": { "required": ["gpx_path"] }
        },
        {
          "required": [
            "gpx_path",
            "activity_type",
            "route_name",
            "region"
          ],
          "not": { "required": ["existing_slug"] }
        }
      ]
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/proposal" }
  ]
}
