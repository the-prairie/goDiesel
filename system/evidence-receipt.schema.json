{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godiesel.local/system/evidence-receipt.schema.json",
  "title": "goDiesel verification evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "receipt_id",
    "capability",
    "verb",
    "authority",
    "started_at",
    "finished_at",
    "status",
    "repository",
    "inputs",
    "covered_inputs",
    "proof_fingerprint",
    "selection",
    "gates",
    "configuration",
    "warnings",
    "named_degradation",
    "external_target",
    "recovery_paths",
    "safe_next_actions",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "document_type": { "const": "godiesel-evidence-receipt" },
    "receipt_id": { "type": "string", "minLength": 1 },
    "capability": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "verb": { "enum": ["inspect", "plan", "apply", "verify", "release"] },
    "authority": {
      "enum": ["read-only", "ephemeral-local", "canonical-local", "external-durable", "destructive"]
    },
    "started_at": { "type": "string", "minLength": 1 },
    "finished_at": { "type": "string", "minLength": 1 },
    "status": { "enum": ["passed", "failed", "blocked", "not_run"] },
    "repository": { "$ref": "#/$defs/repository" },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/digest" }
    },
    "covered_inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/coveredInput" }
    },
    "proof_fingerprint": { "$ref": "#/$defs/sha256" },
    "selection": { "$ref": "#/$defs/selection" },
    "gates": {
      "type": "array",
      "items": { "$ref": "#/$defs/gate" }
    },
    "configuration": {
      "type": "array",
      "items": { "$ref": "#/$defs/configuration" }
    },
    "warnings": { "$ref": "#/$defs/issues" },
    "named_degradation": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "external_target": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/externalTarget" }
      ]
    },
    "recovery_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "safe_next_actions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "branch", "worktree_sha256", "dirty_state"],
      "properties": {
        "commit": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[a-f0-9]{40}$" }
          ]
        },
        "branch": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "worktree_sha256": { "$ref": "#/$defs/sha256" },
        "dirty_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["clean", "sha256"],
          "properties": {
            "clean": { "type": "boolean" },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "sha256"],
      "properties": {
        "kind": { "enum": ["input", "plan", "output", "data", "configuration", "provider"] },
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "coveredInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "name", "state", "sha256"],
      "properties": {
        "category": {
          "enum": ["implementation", "contract", "fixture", "configuration", "data", "provider"]
        },
        "name": { "type": "string", "minLength": 1 },
        "state": { "enum": ["matched", "absent", "present", "missing", "target"] },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "tiers", "impact_rules"],
      "properties": {
        "mode": { "enum": ["explicit", "manifest"] },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["focused", "ticket", "release", "live"] },
          "uniqueItems": true
        },
        "impact_rules": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "uniqueItems": true
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tier",
        "command",
        "cwd",
        "provider",
        "started_at",
        "finished_at",
        "status",
        "exit_code",
        "output_sha256"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "tier": { "enum": ["focused", "ticket", "release", "live"] },
        "command": { "type": "string", "minLength": 1 },
        "cwd": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "started_at": { "type": "string", "minLength": 1 },
        "finished_at": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "blocked", "not_run"] },
        "exit_code": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0 }
          ]
        },
        "output_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "present", "required_for"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "present": { "type": "boolean" },
        "required_for": {
          "type": "array",
          "items": { "enum": ["inspect", "plan", "apply", "verify", "verify:live", "release"] },
          "uniqueItems": true
        }
      }
    },
    "externalTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name_sha256"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "name_sha256": { "$ref": "#/$defs/sha256" },
        "immutable_id": { "type": "string", "minLength": 1 },
        "stable_alias": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "remediation"],
        "properties": {
          "code": { "type": "string", "pattern": "^GODIESEL_[A-Z0-9_]+$" },
          "message": { "type": "string", "minLength": 1 },
          "remediation": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
