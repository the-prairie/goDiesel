{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godiesel.local/system/build-identity.schema.json",
  "title": "goDiesel deployed build identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "artifact_kind", "commit", "tree", "build_id"],
  "properties": {
    "schema_version": { "const": 1 },
    "document_type": { "const": "godiesel-build-identity" },
    "artifact_kind": { "enum": ["built-artifact", "development-server", "unverified-working-tree-artifact"] },
    "artifact_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "tree": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "build_id": { "type": "string", "format": "uuid" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "artifact_kind": { "enum": ["built-artifact", "unverified-working-tree-artifact"] } },
        "required": ["artifact_kind"]
      },
      "then": { "required": ["artifact_manifest_sha256"] }
    }
  ]
}
