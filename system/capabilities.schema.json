{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godiesel.local/schemas/capabilities.schema.json",
  "title": "goDiesel capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "capabilities", "impact_rules"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": 1 },
    "document_type": { "const": "godiesel-capability-manifest" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    },
    "impact_rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/impactRule" }
    }
  },
  "$defs": {
    "authority": {
      "enum": [
        "read-only",
        "ephemeral-local",
        "canonical-local",
        "external-durable",
        "destructive"
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "cwd"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "cwd": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "proof_inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/proofInput" }
        }
      }
    },
    "proofInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "paths"],
      "properties": {
        "category": {
          "enum": ["implementation", "contract", "fixture", "configuration", "data", "provider"]
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required_for", "sensitive"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "required_for": {
          "type": "array",
          "items": { "enum": ["inspect", "plan", "apply", "verify", "verify:live", "release"] },
          "uniqueItems": true
        },
        "sensitive": { "type": "boolean" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "entity",
        "summary",
        "verbs",
        "authority",
        "inputs",
        "reads",
        "writes",
        "external_effects",
        "required_files",
        "configuration",
        "commands",
        "preconditions",
        "idempotency",
        "recovery",
        "artifacts",
        "invariants",
        "verification",
        "documents"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "entity": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "verbs": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["inspect", "plan", "apply", "verify", "release"] },
          "uniqueItems": true
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inspect": { "$ref": "#/$defs/authority" },
            "plan": { "$ref": "#/$defs/authority" },
            "apply": { "$ref": "#/$defs/authority" },
            "verify": { "$ref": "#/$defs/authority" },
            "release": { "$ref": "#/$defs/authority" }
          }
        },
        "inputs": { "$ref": "#/$defs/verbStringLists" },
        "reads": { "$ref": "#/$defs/pathList" },
        "writes": { "$ref": "#/$defs/pathList" },
        "external_effects": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "required_files": { "$ref": "#/$defs/pathList" },
        "configuration": {
          "type": "array",
          "items": { "$ref": "#/$defs/configuration" }
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inspect": { "$ref": "#/$defs/commandList" },
            "plan": { "$ref": "#/$defs/commandList" },
            "apply": { "$ref": "#/$defs/commandList" },
            "verify": { "$ref": "#/$defs/commandList" },
            "release": { "$ref": "#/$defs/commandList" }
          }
        },
        "preconditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "idempotency": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inspect": { "$ref": "#/$defs/idempotency" },
            "plan": { "$ref": "#/$defs/idempotency" },
            "apply": { "$ref": "#/$defs/idempotency" },
            "verify": { "$ref": "#/$defs/idempotency" },
            "release": { "$ref": "#/$defs/idempotency" }
          }
        },
        "recovery": { "$ref": "#/$defs/verbStrings" },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "uniqueItems": true
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["focused", "ticket", "release", "live"],
          "properties": {
            "focused": { "$ref": "#/$defs/commandList" },
            "ticket": { "$ref": "#/$defs/commandList" },
            "release": { "$ref": "#/$defs/commandList" },
            "live": { "$ref": "#/$defs/commandList" }
          }
        },
        "documents": { "$ref": "#/$defs/pathList" }
      }
    },
    "pathList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "commandList": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    },
    "verbStringLists": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inspect": { "$ref": "#/$defs/stringList" },
        "plan": { "$ref": "#/$defs/stringList" },
        "apply": { "$ref": "#/$defs/stringList" },
        "verify": { "$ref": "#/$defs/stringList" },
        "release": { "$ref": "#/$defs/stringList" }
      }
    },
    "verbStrings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inspect": { "type": "string", "minLength": 1 },
        "plan": { "type": "string", "minLength": 1 },
        "apply": { "type": "string", "minLength": 1 },
        "verify": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "minLength": 1 }
      }
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "idempotency": {
      "enum": [
        "read-only",
        "deterministic",
        "idempotent",
        "guarded",
        "external-check-required"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "location", "persistence"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "minLength": 1 },
        "persistence": {
          "enum": ["runtime", "ignored-local", "tracked-local", "generated-local", "external"]
        },
        "schema": { "type": "string", "minLength": 1 }
      }
    },
    "impactGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "tier"],
      "properties": {
        "capability": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "tier": { "enum": ["focused", "ticket", "release", "live"] }
      }
    },
    "impactInvariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "id"],
      "properties": {
        "capability": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
      }
    },
    "impactRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "paths", "capabilities", "category", "gates", "invariants", "reason"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "uniqueItems": true
        },
        "category": {
          "enum": ["implementation", "contract", "fixture", "configuration", "data", "provider", "documentation"]
        },
        "gates": {
          "type": "array",
          "items": { "$ref": "#/$defs/impactGate" }
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/impactInvariant" },
          "uniqueItems": true
        },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
