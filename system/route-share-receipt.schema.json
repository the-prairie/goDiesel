{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://godiesel.local/system/route-share-receipt.schema.json",
  "title": "goDiesel route-share run receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "receipt_id",
    "created_at",
    "capability",
    "verb",
    "authority",
    "outcome",
    "exit_code",
    "result_sha256",
    "result_artifact",
    "lineage"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "document_type": { "const": "godiesel-route-share-receipt" },
    "receipt_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "capability": { "const": "route-share" },
    "verb": { "enum": ["plan", "apply", "verify", "release"] },
    "authority": { "enum": ["ephemeral-local", "canonical-local", "external-durable"] },
    "outcome": { "enum": ["passed", "blocked", "incomplete"] },
    "exit_code": { "type": "integer", "minimum": 0 },
    "result_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "route_slug": { "type": "string", "minLength": 1 },
    "proposal_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "result_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^\\.route-share/results/.+\\.json$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "path": { "type": "string", "pattern": "^\\.route-share/proposals/.+\\.json$" }
      }
    },
    "creation_report": { "$ref": "#/$defs/digest-result" },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "sha256"],
      "properties": {
        "mode": { "enum": ["check", "preview"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "release_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_alias", "authorized_share_name", "replacement_authorized"],
      "properties": {
        "stable_alias": { "type": "string", "format": "uri" },
        "authorized_share_name": { "type": "string", "minLength": 1 },
        "immutable_deployment_url": { "type": "string", "format": "uri" },
        "guide_url": { "type": "string", "format": "uri" },
        "replay_url": { "type": "string", "format": "uri" },
        "smoke_status": { "const": "passed" },
        "replacement_authorized": { "type": "boolean" }
      }
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["receipt_id", "verb", "outcome", "path", "result_sha256"],
        "properties": {
          "receipt_id": { "type": "string", "minLength": 1 },
          "verb": { "enum": ["plan", "apply", "verify", "release"] },
          "outcome": { "enum": ["passed", "blocked", "incomplete"] },
          "path": { "type": "string", "pattern": "^\\.route-share/runs/.+\\.json$" },
          "result_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verb": { "const": "release" },
          "outcome": { "const": "passed" }
        },
        "required": ["verb", "outcome"]
      },
      "then": {
        "required": ["release_target"],
        "properties": {
          "release_target": {
            "required": [
              "stable_alias",
              "authorized_share_name",
              "immutable_deployment_url",
              "guide_url",
              "replay_url",
              "smoke_status",
              "replacement_authorized"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "digest-result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "sha256"],
      "properties": {
        "result": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
